# ---------------------------------------------------------------------------
# Environment for deploy/docker-compose.yml.
#
# In production these live in Dokploy's Environment tab, not in a file.
# Copy this to deploy/.env only for local testing — deploy/.env is gitignored
# and must never be committed.
#
# Values marked TBD are decisions for the human running the server.
# ---------------------------------------------------------------------------

# --- Images ----------------------------------------------------------------

# GHCR namespace the build workflow pushes to. Lowercased GitHub owner.
GHCR_OWNER=crazy92

# "latest" in normal operation. Pin a sha-<short> tag to roll back to a known
# good build (see RUNBOOK.md → Rollback).
AC_IMAGE_TAG=latest

# --- Database --------------------------------------------------------------

# TBD — root password for the MySQL container. Required; the stack refuses to
# start without it. Only reachable from inside ac-network and, if published,
# from loopback on the CT.
DOCKER_DB_ROOT_PASSWORD=TBD

# The CT runs other services, so the DB is published on loopback and off 3306.
# Set DOCKER_DB_BIND_IP to the LAN IP only if you really want a remote client
# (e.g. Keira3 from a workstation) to reach it — never forward this on the
# router.
DOCKER_DB_BIND_IP=127.0.0.1
DOCKER_DB_EXTERNAL_PORT=13306

# --- Published ports -------------------------------------------------------

# Forwarded on the UniFi router to the CT's LAN IP. Changing the world port
# also changes realmlist.port (ac-realmlist-init reads it from here).
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085

# SOAP/remote console. Loopback by default; set the bind IP to the CT's LAN IP
# to reach it from the LAN. NEVER forward this port on the router.
DOCKER_SOAP_BIND_IP=127.0.0.1
DOCKER_SOAP_EXTERNAL_PORT=7878

# --- Realm -----------------------------------------------------------------
# Written into acore_auth.realmlist by the ac-realmlist-init one-shot on every
# deploy. All three are required.

REALM_NAME=Friends

# TBD — what clients outside the LAN connect to: public IP or a DNS name that
# resolves to it. Must be reachable from the internet on DOCKER_WORLD_EXTERNAL_PORT.
REALM_ADDRESS=TBD

# TBD — the LXC's LAN IP. Clients inside the LAN are handed this instead, so
# their traffic doesn't hairpin through the router.
REALM_LOCAL_ADDRESS=TBD

# TBD — LAN netmask, e.g. 255.255.255.0 for a /24.
REALM_LOCAL_SUBNET_MASK=255.255.255.0

# --- worldserver.conf overrides --------------------------------------------
# AzerothCore reads any conf key from an AC_-prefixed env var; the name is
# derived from the key (upper snake case, dots -> underscores, camelCase
# splits): AllowTwoSide.Interaction.Calendar -> AC_ALLOW_TWO_SIDE_INTERACTION_CALENDAR
# Only the keys listed here are wired through deploy/docker-compose.yml; add a
# key to both files to start tuning a new one.

# Realm id — must match the realmlist row this realm uses.
AC_REALM_ID=1

# Cross-faction. A mixed-faction friend group needs to group, chat and trade
# across the divide; all default to on for this server.
AC_ALLOW_TWO_SIDE_ACCOUNTS=1
AC_ALLOW_TWO_SIDE_INTERACTION_CALENDAR=1
AC_ALLOW_TWO_SIDE_INTERACTION_CHAT=1
AC_ALLOW_TWO_SIDE_INTERACTION_CHANNEL=1
AC_ALLOW_TWO_SIDE_INTERACTION_GROUP=1
AC_ALLOW_TWO_SIDE_INTERACTION_GUILD=1
AC_ALLOW_TWO_SIDE_INTERACTION_ARENA=1
AC_ALLOW_TWO_SIDE_INTERACTION_AUCTION=1

# Rates. 1 = blizzlike. TBD whether the group wants accelerated levelling.
AC_RATE_XP_KILL=1
AC_RATE_XP_QUEST=1
AC_RATE_XP_QUEST_DF=1
AC_RATE_XP_EXPLORE=1
AC_RATE_XP_PET=1
AC_RATE_DROP_MONEY=1
AC_RATE_HONOR=1
AC_RATE_REPUTATION_GAIN=1
AC_RATE_REST_IN_GAME=1

# SOAP. Off by default. If enabled, AC_SOAP_IP must stay 0.0.0.0 so the
# listener is reachable from outside the container namespace — the exposure is
# controlled by DOCKER_SOAP_BIND_IP above, not by this.
AC_SOAP_ENABLED=0
AC_SOAP_IP=0.0.0.0
AC_SOAP_PORT=7878

# --- mod-autobalance -------------------------------------------------------
# Scales dungeon and raid content to the size of the group. Note that
# env/dist/etc/modules/AutoBalance.conf is intentionally absent — the module's
# built-in defaults apply and these variables override them, so an ERROR line
# "> Config::LoadFile: Failed open file '.../modules/AutoBalance.conf'" at
# worldserver startup is expected and harmless.

AC_AUTO_BALANCE_ENABLE_GLOBAL=1
AC_AUTO_BALANCE_ENABLE_OTHER_NORMAL=1
AC_AUTO_BALANCE_ENABLE_OTHER_HEROIC=1

# Scale down to a single player. Raise if you'd rather content stay tuned for
# a minimum party size.
AC_AUTO_BALANCE_MIN_PLAYERS=1
AC_AUTO_BALANCE_MIN_PLAYERS_HEROIC=1
AC_AUTO_BALANCE_MIN_PLAYERS_RAID=1
AC_AUTO_BALANCE_MIN_PLAYERS_RAID_HEROIC=1

# Difficulty curve. 0.5 = module default; lower is easier at low player
# counts, higher is harder.
AC_AUTO_BALANCE_INFLECTION_POINT=0.5
AC_AUTO_BALANCE_INFLECTION_POINT_HEROIC=0.5
AC_AUTO_BALANCE_INFLECTION_POINT_RAID=0.5

# Pull creature levels toward the group's level, and scale XP/loot with the
# adjusted difficulty.
AC_AUTO_BALANCE_LEVEL_SCALING=1
AC_AUTO_BALANCE_LEVEL_SCALING_METHOD=dynamic
AC_AUTO_BALANCE_REWARD_SCALING_METHOD=dynamic

# Pretend the group is N players larger (positive) or smaller (negative).
AC_AUTO_BALANCE_PLAYER_COUNT_DIFFICULTY_OFFSET=0

# --- mod-playerbots ---------------------------------------------------------
# Simulated players. This is the module the whole core swap is for: our master
# tracks mod-playerbots/azerothcore-wotlk (branch Playerbot), because the
# module does not build against upstream AzerothCore.
#
# It keeps a fourth database, acore_playerbots, created and migrated by
# ac-db-import — which is why AC_UPDATES_ENABLE_DATABASES is 15 and not the
# shipped 7. Nothing to set here for that; the compose file wires it.
#
# Population. Spread over levels 1-80 across two continents, this number has
# to be large before the world looks inhabited: 300 is roughly four bots per
# level, and 500 is the module's own default. CPU is not the limit — see the
# load governor below — RAM is, at roughly a player session per bot. Check
# `free -h` on the CT and `docker stats ac-worldserver` after a change.
AC_AI_PLAYERBOT_ENABLED=1
AC_AI_PLAYERBOT_MIN_RANDOM_BOTS=300
AC_AI_PLAYERBOT_MAX_RANDOM_BOTS=300
AC_AI_PLAYERBOT_RANDOM_BOT_AUTOLOGIN=1

# Load governor (all three are the module's compiled defaults, listed here so
# you know the knobs exist). BotActiveAlone is the percentage of bots fully
# simulated while alone; smart scale raises and lowers that automatically to
# keep the worldserver's update diff inside the floor/ceiling band. Bots in
# your zone, within 150 yards, in combat, in a group with you or queued for
# LFG are always active on top of this.
# AC_AI_PLAYERBOT_BOT_ACTIVE_ALONE=10
# AC_AI_PLAYERBOT_BOT_ACTIVE_ALONE_SMART_SCALE=1
# AC_AI_PLAYERBOT_BOT_ACTIVE_ALONE_SMART_SCALE_DIFF_LIMIT_CEILING=200

# Rotate which bots are online instead of keeping a fixed roster — different
# names around each session, from a pool PeriodicOnlineOfflineRatio times the
# online count. Costs more bot characters in the database, not more load.
# AC_AI_PLAYERBOT_ENABLE_PERIODIC_ONLINE_OFFLINE=1
# AC_AI_PLAYERBOT_PERIODIC_ONLINE_OFFLINE_RATIO=2.0

# Bots stop running when no real player is online. Saves the CT from grinding
# 24/7 for nobody. Set to 0 if you want a "living" world at all hours.
AC_AI_PLAYERBOT_DISABLED_WITHOUT_REAL_PLAYER=1

# Who may drive their own characters as bots: 0 off, 1 GM only, 2 all players,
# 3 activate on login. 2 suits a group of friends.
AC_AI_PLAYERBOT_SELF_BOT_LEVEL=2

AC_AI_PLAYERBOT_RANDOM_BOT_MIN_LEVEL=1
AC_AI_PLAYERBOT_RANDOM_BOT_MAX_LEVEL=80

# --- mod-ah-bot -------------------------------------------------------------
# Populates the auction house. Needs a one-time setup that cannot be done from
# env alone, because it posts auctions AS a character:
#
#   1. account create ahbot <password>          (worldserver console)
#   2. log in on that account, create one character per faction, log out
#   3. find the account id:
#        SELECT id FROM acore_auth.account WHERE username = 'AHBOT';
#   4. put that id in AC_AUCTION_HOUSE_BOT_ACCOUNT and flip the two switches
#
# Until the account id is non-zero the module logs an error and does nothing.
# Do not play on that character; browsing the AH with it misbehaves.
AC_AUCTION_HOUSE_BOT_ACCOUNT=0
AC_AUCTION_HOUSE_BOT_ENABLE_SELLER=0
AC_AUCTION_HOUSE_BOT_ENABLE_BUYER=0

# --- mod-transmog, mod-solo-lfg ---------------------------------------------
# Nothing to configure: both ship compiled defaults that are already on
# (Transmogrification.* and SoloLFG.*). Add keys here and in the compose file
# only when you want to change one.

# ---------------------------------------------------------------------------
# The variables below are used by deploy/redeploy.sh and deploy/backup.sh on
# the Dokploy host. They are NOT read by docker compose — keep them in the
# root's environment or in an ops-only env file, not in Dokploy's Environment
# tab (that one ends up inside containers).
# ---------------------------------------------------------------------------

# DOKPLOY_URL=http://localhost:3000
# DOKPLOY_API_KEY=TBD
# DOKPLOY_COMPOSE_ID=TBD
# Only needed for the fallback paths in redeploy.sh / backup.sh. Dokploy always
# clones to /etc/dokploy/compose/<appName>/code, so:
# AC_COMPOSE_FILE=/etc/dokploy/compose/<appName>/code/deploy/docker-compose.yml
# BACKUP_DIR=/var/backups/azerothcore
# BACKUP_KEEP_DAYS=14
